  "grammar": [
    {
      "title": "Asking about the weather",
      "body": "The most common question is **Wie ist das Wetter?** You can answer in many ways. Most weather sentences start with **es** (it). In Germany, sunshine means good weather, so people say **Es ist schönes Wetter.** when the sun is out. Talking about the weather is a very common small-talk topic.\n\nFor temperature, ask **Wie viel Grad sind es?** The verb is plural (**sind**) because the number is plural. In Germany the temperature is measured in Celsius.",
      "ar": "في الألمانية نقول عن الطقس: Es regnet (إنها تمطر) - الضمير es لا يُترجم.",
      "examples": [
        { "de": "Wie ist das Wetter heute?", "en": "What is the weather like today?" },
        { "de": "Es ist ziemlich windig heute.", "en": "It is quite windy today." },
        { "de": "Wie viel Grad sind es?", "en": "How many degrees is it?" },
        { "de": "Die Temperatur liegt bei 20 Grad.", "en": "The temperature is around 20 degrees." }
      ]
    },
    {
      "title": "From noun to adjective",
      "body": "Many weather nouns have a matching adjective ending in **-ig**, **-isch** or **-t**. Use the adjective after **Es ist ...**",
      "table": {
        "head": ["Noun", "Adjective", "English"],
        "rows": [
          ["die Sonne", "sonnig", "sunny"],
          ["der Regen", "regnerisch", "rainy"],
          ["die Wolke", "bewölkt", "cloudy"],
          ["der Wind", "windig", "windy"],
          ["der Sturm", "stürmisch", "stormy"],
          ["der Nebel", "neblig", "foggy"]
        ]
      },
      "examples": [
        { "de": "Es ist sonnig.", "en": "It is sunny." },
        { "de": "Es ist stürmisch.", "en": "It is stormy." }
      ]
    }
  ],
  "mistakes": [
    { "wrong": "Es ist regnet.", "right": "Es regnet.", "why": "*regnen* is already the verb; do not add *ist*." },
    { "wrong": "Es ist 20 Grad.", "right": "Es sind 20 Grad.", "why": "With a number of degrees use plural *sind*." }
  ],
  "pronunciation": [
    { "de": "St- / Sp- at the start", "tip": "Say *sht*: *Sturm* sounds like 'Shtoorm'." },
    { "de": "ü", "tip": "Round your lips as for 'oo' and say 'ee': *Stürme*, *stürmisch*." },
    { "de": "ö", "tip": "Round your lips and say 'e': *Regenbögen*, *bewölkt*." }
  ],
  "dialogues": [
    {
      "title": "Small talk about the weather",
      "sup": true,
      "lines": [
        { "who": "A", "de": "Hallo! Wie ist das Wetter heute?", "en": "Hello! What is the weather like today?" },
        { "who": "B", "de": "Es ist schönes Wetter. Es ist sonnig.", "en": "It is nice weather. It is sunny." },
        { "who": "A", "de": "Wie viel Grad sind es?", "en": "How many degrees is it?" },
        { "who": "B", "de": "Es sind 20 Grad.", "en": "It is 20 degrees." },
        { "who": "A", "de": "Super! Gestern war es grau.", "en": "Great! Yesterday it was grey." },
        { "who": "B", "de": "Ja, heute ist das Wetter traumhaft.", "en": "Yes, today the weather is wonderful." }
      ]
    }
  ],
  "tip": "Learn each weather noun with its adjective as a pair (der Wind - windig). That doubles your vocabulary quickly.",
  "comprehension": [
