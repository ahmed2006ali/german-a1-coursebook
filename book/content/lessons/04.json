  "grammar": [
    {
      "title": "Units first, then tens",
      "body": "In English you say the tens first: twenty-**one**. In German the order is reversed: first the **unit**, then **und** (and), then the **ten**: **ein-und-zwanzig** ('one and twenty').\n\nThe whole number is written as **one word** without spaces. The -s of **eins** disappears: **einundzwanzig** (not einsundzwanzig).",
      "ar": "الترتيب بالألمانية: الآحاد ثم und ثم العشرات، مثل العربية: واحد وعشرون.",
      "table": {
        "head": ["Number", "Unit", "+ und +", "Ten", "Word"],
        "rows": [
          ["21", "ein", "und", "zwanzig", "einundzwanzig"],
          ["32", "zwei", "und", "dreißig", "zweiunddreißig"],
          ["43", "drei", "und", "vierzig", "dreiundvierzig"],
          ["54", "vier", "und", "fünfzig", "vierundfünfzig"],
          ["65", "fünf", "und", "sechzig", "fünfundsechzig"],
          ["76", "sechs", "und", "siebzig", "sechsundsiebzig"],
          ["87", "sieben", "und", "achtzig", "siebenundachtzig"],
          ["98", "acht", "und", "neunzig", "achtundneunzig"]
        ]
      }
    },
    {
      "title": "The tens",
      "body": "The tens end in **-zig**, with two exceptions: **dreißig** (30) ends in **-ßig**, and two numbers lose letters: **sechzig** (sechs without -s) and **siebzig** (sieben without -en). 100 is **hundert** or **einhundert**.",
      "table": {
        "head": ["Number", "Word"],
        "rows": [
          ["20", "zwanzig"],
          ["30", "dreißig"],
          ["40", "vierzig"],
          ["50", "fünfzig"],
          ["60", "sechzig"],
          ["70", "siebzig"],
          ["80", "achtzig"],
          ["90", "neunzig"],
          ["100", "hundert"]
        ]
      }
    },
    {
      "title": "Asking and giving age",
      "body": "Use **alt** (old) with **sein** (to be). Formal: **Wie alt sind Sie?** Informal: **Wie alt bist du?** Answer with **Ich bin ... Jahre alt.** In Germany it can be slightly rude to ask an adult's age, so use this question mainly for practice.",
      "examples": [
        { "de": "Ich bin fünfundzwanzig Jahre alt.", "en": "I am 25 years old." },
        { "de": "Wie alt bist du?", "en": "How old are you?" }
      ]
    }
  ],
  "mistakes": [
    { "wrong": "zwanzig und eins", "right": "einundzwanzig", "why": "German says the unit first and writes everything as one word." },
    { "wrong": "einsundzwanzig", "right": "einundzwanzig", "why": "The -s of *eins* is dropped." },
    { "wrong": "sechszig", "right": "sechzig", "why": "*sechs* loses its -s before -zig." },
    { "wrong": "siebenzig", "right": "siebzig", "why": "*sieben* loses -en before -zig." }
  ],
  "pronunciation": [
